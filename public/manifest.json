{
  "short_name": "Wallet Voice",
  "name": "Billetera por Voz - Gestión de Deudas",
  "description": "Aplicación de billetera virtual con control por voz para gestionar deudas y pagos",
  "icons": [
    {
      "src": "/logo192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "/logo512.png",
      "type": "image/png", 
      "sizes": "512x512",
      "purpose": "any maskable"
    },
  
    {
      "src": "/logo144.png",
      "type": "image/png",
      "sizes": "144x144"
    },
    {
      "src": "/logo96.png",
      "type": "image/png",
      "sizes": "96x96"
    },
    {
      "src": "/logo72.png", 
      "type": "image/png",
      "sizes": "72x72"
    },
    {
      "src": "/logo48.png",
      "type": "image/png",
      "sizes": "48x48"
    }
  ],
  "start_url": "/",
  "background_color": "#3b82f6",
  "display": "standalone",
  "scope": "/",
  "theme_color": "#3b82f6",
  "orientation": "portrait-primary",
  "categories": ["finance", "productivity", "utilities"],
  

  "prefer_related_applications": false,
  

  "apple-mobile-web-app-capable": "yes",
  "apple-mobile-web-app-status-bar-style": "black-translucent",
  "apple-mobile-web-app-title": "Wallet Voice",
  

  "display_override": ["window-controls-overlay"],
  

  "id": "/",
  "dir": "ltr",
  "lang": "es",
  
  "shortcuts": [
    {
      "name": "Agregar deuda por voz",
      "short_name": "Voz",
      "description": "Agregar deuda usando comando de voz",
      "url": "/?voice=true",
      "icons": [{ "src": "/icons/mic-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Consultar deudas",
      "short_name": "Consultar", 
      "description": "Ver todas las deudas",
      "url": "/debts",
      "icons": [{ "src": "/icons/list-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Resumen general",
      "short_name": "Resumen",
      "description": "Ver resumen de deudas",
      "url": "/summary",
      "icons": [{ "src": "/icons/chart-192.png", "sizes": "192x192" }]
    }
  ],
  
 
  "protocol_handlers": [
    {
      "protocol": "web+deudas",
      "url": "/?debt=%s"
    }
  ]
}